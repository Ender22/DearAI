{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "dearai",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dearai",
			"database_id": "6688a80d-c6f7-4282-a0b2-55c52329852f",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Public Turnstile site key (widget "Dear AI letter form"). Local dev overrides it via .dev.vars.
		"TURNSTILE_SITE_KEY": "0x4AAAAAAF4YT-NqNbqK4QuC",
		// Cloudflare Access team domain and app audience tag, used to verify /admin requests.
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	}
	// Secrets (set with `wrangler secret put`, and in .dev.vars for local dev):
	//   TURNSTILE_SECRET_KEY, IP_SALT
}
