# Copy to .dev.vars for local development.
# Cloudflare's always-pass Turnstile test keys:
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
IP_SALT=local-dev-salt
# Lets you use /admin locally without Cloudflare Access. Ignored in production builds.
ADMIN_DEV_BYPASS=1
