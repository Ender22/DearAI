{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "dearai",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// www redirects to the apex in src/middleware.ts.
	"routes": [
		{ "pattern": "dearai.earth", "custom_domain": true },
		{ "pattern": "www.dearai.earth", "custom_domain": true }
	],
	"workers_dev": true,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dearai",
			"database_id": "6688a80d-c6f7-4282-a0b2-55c52329852f",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Public Turnstile site key (widget "Dear AI letter form"). Local dev overrides it via .dev.vars.
		"TURNSTILE_SITE_KEY": "0x4AAAAAAF4YT-NqNbqK4QuC",
		// Cloudflare Access team domain and app audience tag, used to verify /admin requests.
		"ACCESS_TEAM_DOMAIN": "fragrant-cell-5e65.cloudflareaccess.com",
		"ACCESS_AUD": "f7b5ccf8cc112a621ff77b447426a0def925254981ce14d3587aa51ae061d79b"
	}
	// Secrets (set with `wrangler secret put`, and in .dev.vars for local dev):
	//   TURNSTILE_SECRET_KEY, IP_SALT
}
